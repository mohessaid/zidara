{
  "name": "zidara-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "VITE_ZIDARA_DEMO=browser vite build --outDir dist-demo",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "e2e": "playwright test",
    "smoke": "playwright test -c playwright.deploy.config.ts",
    "demo": "playwright test -c playwright.static.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.6.5",
    "chrome-launcher": "^1.2.2",
    "fake-indexeddb": "6.2.5",
    "lighthouse": "13.5.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "5.3.0",
    "idb": "8.0.4"
  }
}
